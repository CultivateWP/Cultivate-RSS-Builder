<?xml version="1.0"?>
<ruleset name="Cultivate RSS Builder">
	<description>WordPress standards and PHP compatibility for first-party plugin code.</description>
	<file>cultivate-rss-builder.php</file>
	<file>includes</file>
	<exclude-pattern>/includes/updater/</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="s"/>
	<config name="minimum_supported_wp_version" value="4.6"/>
	<config name="testVersion" value="7.0-"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cultivate-rss-builder"/>
			</property>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
